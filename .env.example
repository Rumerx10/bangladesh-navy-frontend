# Copy to `.env` and fill in. Read by `next build` — values are baked into the
# client bundle, so changing any of them requires a rebuild, not a restart.
# NEXT_PUBLIC_* is public by definition: never put a secret here.

# Backend REST API (required — no fallback in code)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8001/api/v1

# Google OAuth (required for Google login — no fallback in code)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Site metadata — all optional, defaults live in src/config/siteConfig.ts
NEXT_PUBLIC_SITE_NAME=Bangladesh Navy
NEXT_PUBLIC_SITE_DESCRIPTION=
NEXT_PUBLIC_ADDRESS=BNHOC, Chittagong, Bangladesh
NEXT_PUBLIC_PHONE_1=+8801769722446
NEXT_PUBLIC_PHONE_2=0233334250030
NEXT_PUBLIC_EMAIL=bnhoc@navy.mil.bd

# Currency display — optional
NEXT_PUBLIC_CURRENCY=BDT
NEXT_PUBLIC_CURRENCY_SYMBOL=৳
